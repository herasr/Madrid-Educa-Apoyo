# Variables de entorno opcionales para compilación y despliegue estático.
# La aplicación web funciona 100 % en cliente con datos públicos y no requiere claves de IA ni bases de datos privadas.

# VITE_SITE_URL: URL pública base usada en etiquetas OpenGraph, Twitter Card y Schema.org (ej. https://herasr.github.io/Madrid-Educa-Apoyo).
VITE_SITE_URL="https://herasr.github.io/Madrid-Educa-Apoyo"

# VITE_BASE_PATH: Subruta pública del despliegue (ej. /Madrid-Educa-Apoyo/ en GitHub Pages o / en dominio raíz).
VITE_BASE_PATH="/"

